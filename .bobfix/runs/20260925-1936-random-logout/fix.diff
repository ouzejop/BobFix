diff --git a/demo-app/api/tests/concurrent-refresh.test.ts b/demo-app/api/tests/concurrent-refresh.test.ts
new file mode 100644
index 0000000..005ef83
--- /dev/null
+++ b/demo-app/api/tests/concurrent-refresh.test.ts
@@ -0,0 +1,64 @@
+/**
+ * Regression test for the concurrent-refresh race condition.
+ *
+ * Root cause: when two POST /auth/refresh requests arrive simultaneously with
+ * the same rt cookie, both rotate() calls pass the `if (row.revoked_at)` guard
+ * (both read row before either revokes it), then the first revokes the row
+ * synchronously and yields at `await`.  The second — now starting — calls
+ * findByHash and sees revoked_at set, misidentifies it as a reuse attack, calls
+ * revokeFamily(), and the first request's newly-issued access token is rejected.
+ *
+ * Fix: tokenService.rotate() uses repo.revokeIfNotRevoked() (conditional UPDATE
+ * WHERE revoked_at IS NULL) so only the first concurrent caller wins; the second
+ * caller gets changes=0, throws TokenReuseDetected WITHOUT calling revokeFamily.
+ * The inflight map in tokenService deduplicates identical concurrent calls so
+ * both callers share one rotation promise.
+ */
+import { describe, it, expect } from "vitest";
+import { openDb } from "../src/db/connection.js";
+import { seed } from "../src/db/seed.js";
+import { makeTokenService, sha256 } from "../src/services/tokenService.js";
+import { makeUserRepo } from "../src/db/userRepo.js";
+import { makeRefreshTokenRepo } from "../src/db/refreshTokenRepo.js";
+import { REFRESH_TOKEN_TTL_DAYS } from "../src/config.js";
+
+describe("concurrent refresh — race condition regression", () => {
+  it("concurrent rotate() calls with the same token do not revoke the family", async () => {
+    const db = openDb(":memory:");
+    seed(db);
+
+    const tokenService = makeTokenService(db);
+
+    // Issue a login token pair to get a real refresh token
+    const userRepo = makeUserRepo(db);
+    const user = await userRepo.findById(1);
+    const { refresh: refreshToken } = await tokenService.issueForLogin(user);
+
+    // Inject a yield point so that two concurrent rotate() calls actually
+    // interleave: the first will revoke the row and yield; the second starts
+    // and (on unfixed code) would call revokeFamily().
+    //
+    // We simulate this by calling rotate() twice concurrently.  The inflight
+    // map on the fixed code returns the same promise to both callers so only
+    // one rotation is performed and the family stays valid.
+    const [r1, r2] = await Promise.allSettled([
+      tokenService.rotate(refreshToken),
+      tokenService.rotate(refreshToken),
+    ]);
+
+    // At least one call must succeed
+    const successes = [r1, r2].filter((r) => r.status === "fulfilled");
+    expect(successes.length).toBeGreaterThanOrEqual(1);
+
+    // Verify the token family is NOT revoked — the issued access token must be
+    // accepted.  We check this by calling rotate() with the NEW refresh token
+    // (the one issued by the successful rotation).
+    const winner = successes[0] as PromiseFulfilledResult<{ access: string; refresh: string }>;
+    const newRefreshToken = winner.value.refresh;
+
+    // On unfixed code, revokeFamily() was called → isFamilyRevoked returns true
+    // → rotate with the new token throws InvalidToken (401 in the HTTP layer).
+    // On fixed code the family is still valid → rotate succeeds.
+    await expect(tokenService.rotate(newRefreshToken)).resolves.toHaveProperty("access");
+  });
+});
